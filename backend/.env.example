# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartsol
DB_USER=smartsol_user
DB_PASSWORD=<db_password>

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=<jwt_secret_key>
JWT_EXPIRES_IN=7d

# AWS
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=<aws_access_key>
AWS_SECRET_ACCESS_KEY=<aws_secret_key>
AWS_IOT_ENDPOINT=<iot_endpoint>.iot.af-south-1.amazonaws.com
AWS_S3_BUCKET=smartsol-data

# MQTT / AWS IoT Core
MQTT_BROKER=mqtts://<iot_endpoint>.iot.af-south-1.amazonaws.com
MQTT_PORT=8883

# Payments
ECOCASH_API_URL=https://api.ecocash.co.zw/v1
ECOCASH_API_KEY=<ecocash_api_key>
ONEMONEY_API_URL=https://api.onemoney.co.zw/v1
ONEMONEY_API_KEY=<onemoney_api_key>

# Africa's Talking (USSD/SMS)
AT_API_KEY=<africastalking_api_key>
AT_USERNAME=smartsol
AT_SHORTCODE=*123#

# AI Service
AI_SERVICE_URL=http://localhost:5001

# GPS / AWS Location
AWS_LOCATION_TRACKER=SmartSolTracker
